+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.server.neo2;
+
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.ServiceConnection;
+import android.content.pm.PackageManager;
+import android.database.ContentObserver;
+import android.hardware.display.DisplayManager;
+import android.os.Binder;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.ParcelFileDescriptor;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.SharedMemory;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Slog;
+import android.view.Display;
+
+import com.android.server.SystemService;
+
+import java.util.ArrayList;
+import java.util.Random;
+
+/**
+ * Framework-owned ordering authority for B016. The worker owns the current
+ * screen-off epoch and random choice; it never runs on SurfaceFlinger's
+ * composition thread and makes no panel-completion claim.
+ */
+public final class Neo2SleepImageManagerService extends SystemService {
+    private static final String TAG = "Neo2SleepImageManager";
+    private static final String PROVIDER_PACKAGE = "org.neo2.controls";
+    private static final String PROVIDER_CLASS =
+            "org.neo2.controls.SleepImageCatalogService";
+    private static final String PROVIDER_DESCRIPTOR = "org.neo2.controls.ISleepImageCatalog";
+    private static final String SF_SERVICE = "neo2_sleep_image";
+    private static final String SF_DESCRIPTOR = "android.neo2.INeo2SleepImage";
+    private static final String CONTROL_SERVICE = "neo2_sleep_image_manager";
+    private static final String CONTROL_DESCRIPTOR = "android.neo2.INeo2SleepImageManager";
+    private static final String CONTROL_PERMISSION =
+            "org.neo2.controls.permission.MANAGE_SLEEP_IMAGES";
+    private static final int CONTROL_SET_MODE = IBinder.FIRST_CALL_TRANSACTION;
+    private static final int CONTROL_REFRESH_CATALOG = CONTROL_SET_MODE + 1;
+    private static final int CONTROL_RESULT_QUEUED = 0;
+    private static final int PROVIDER_REQUEST_CATALOG = IBinder.FIRST_CALL_TRANSACTION;
+    private static final int PROVIDER_RESULT_CATALOG = IBinder.FIRST_CALL_TRANSACTION;
+    private static final int SF_PUBLISH = IBinder.FIRST_CALL_TRANSACTION;
+    private static final int SF_SCREEN_OFF = SF_PUBLISH + 1;
+    private static final int SF_SCREEN_ON = SF_PUBLISH + 2;
+    private static final int PROVIDER_PROTOCOL_VERSION = 5;
+    private static final int SF_PROTOCOL_VERSION = 3;
+    private static final int RESULT_OK = 0;
+    private static final int RESULT_UNAVAILABLE = 1;
+    private static final int RESULT_EMPTY = 2;
+    private static final int REASON_NONE = 0;
+    private static final int REASON_STORE_IO = 1;
+    private static final int REASON_SHARED_MEMORY = 2;
+    private static final int REASON_NO_VALID_CANDIDATE = 3;
+    private static final String CALLBACK_DESCRIPTOR =
+            "org.neo2.controls.ISleepImageCatalogCallback";
+    private static final String REFRESH_CALLBACK_DESCRIPTOR =
+            "org.neo2.controls.ISleepImageRefreshCallback";
+    private static final int REFRESH_CALLBACK_RESULT = IBinder.FIRST_CALL_TRANSACTION;
+    private static final int MAXIMUM_ENTRIES = 8;
+    private static final int MAXIMUM_REQUESTS_PER_CONNECTION = 2;
+    private static final long REQUEST_TIMEOUT_MILLIS = 5_000;
+    private static final int DISPLAY_STATE_UNINITIALIZED = -1;
+    private static final String MODE_SETTING = "neo2_sleep_image_mode";
+    private static final int MODE_KEEP_LAST_SCREEN = 0;
+    private static final int MODE_SLEEP_IMAGE = 1;
+    private static final int MODE_OVERLAY_SLEEP_IMAGE = 2;
+    private static final int MODE_KOREADER_COVER = 3;
+
+    private final HandlerThread mThread = new HandlerThread(TAG);
+    private final Handler mHandler;
+    private final ContentObserver mModeObserver;
+    // Default-display state and provider work are serialized on mHandler. This
+    // lock also orders Binder callbacks with the active arm/disarm epoch.
+    private final Object mStateLock = new Object();
+    private final Random mRandom = new Random();
+    private final DisplayManager mDisplayManager;
+    private IBinder mProvider;
+    private volatile int mProviderUid = -1;
+    private long mEpoch;
+    private long mRequestGeneration;
+    private int mDefaultDisplayState = DISPLAY_STATE_UNINITIALIZED;
+    private boolean mScreenOff;
+    private int mSleepImageMode = MODE_SLEEP_IMAGE;
+    private boolean mModeInitialized;
+    private boolean mSleepPresentationRequested;
+    private final Neo2SleepImagePowerOffGuard mPowerOffGuard = new Neo2SleepImagePowerOffGuard();
+    private boolean mUserAvailable;
+    private boolean mRequestInFlight;
+    private int mRequestsThisConnection;
+    private long mPendingStoreGeneration;
+    private IBinder mPendingRefreshCallback;
+    // Owned only by the manager worker. Screen-off duplicates this snapshot;
+    // it never asks the Controls provider for a candidate.
+    private ArrayList<Candidate> mRetainedCatalog = new ArrayList<>();
+    private long mRequestsIssued;
+    private long mRequestTransportFailures;
+    private long mRequestTimeouts;
+    private long mProviderResultOk;
+    private long mProviderResultUnavailable;
+    private long mProviderResultEmpty;
+    private long mCallbackAccepted;
+    private long mCallbackInvalid;
+    private long mCallbackStale;
+    private long mCallbackWrongCaller;
+    private long mCallbackScreenOff;
+    private long mCallbackFdFailures;
+    private long mRetainedCatalogUpdates;
+    private long mEndpointAccepted;
+    private long mEndpointRejected;
+    private long mSelections;
+    private long mFallbackSelections;
+    private long mBlackFallbacks;
+    private long mScreenEdgesReceived;
+    private long mScreenOffEpochDelivered;
+    private long mScreenOnEpochDelivered;
+
+    public Neo2SleepImageManagerService(Context context) {
+        super(context);
+        mThread.start();
+        mHandler = new Handler(mThread.getLooper());
+        mModeObserver = new ContentObserver(mHandler) {
+            @Override public void onChange(boolean selfChange) {
+                refreshSleepImageMode();
+            }
+        };
+        mDisplayManager = context.getSystemService(DisplayManager.class);
+    }
+
+    @Override public void onStart() {
+        publishLocalService(Neo2SleepImageManagerInternal.class, mLocalService);
+        publishBinderService(CONTROL_SERVICE, mControlService);
+        IntentFilter filter = new IntentFilter(Intent.ACTION_USER_UNLOCKED);
+        getContext().registerReceiverAsUser(mUserReceiver, UserHandle.ALL, filter, null, null);
+        mDisplayManager.registerDisplayListener(mDisplayListener, mHandler);
+        // Establish the baseline only. An arm requires a later observed
+        // non-OFF -> OFF transition, never service startup or a wake edge.
+        mHandler.post(this::observeDefaultDisplayState);
+    }
+
+    @Override public void onBootPhase(int phase) {
+        if (phase != SystemService.PHASE_SYSTEM_SERVICES_READY || mModeInitialized) {
+            return;
+        }
+        mModeInitialized = true;
+        getContext().getContentResolver().registerContentObserver(
+                Settings.Global.getUriFor(MODE_SETTING), false, mModeObserver);
+        refreshSleepImageMode();
+    }
+
+    private void bindProviderAfterUserAvailable() {
+        Intent provider = new Intent().setComponent(new ComponentName(PROVIDER_PACKAGE, PROVIDER_CLASS));
+        getContext().bindServiceAsUser(provider, mProviderConnection, Context.BIND_AUTO_CREATE,
+                UserHandle.SYSTEM);
+    }
+
+    private final BroadcastReceiver mUserReceiver = new BroadcastReceiver() {
+        @Override public void onReceive(Context context, Intent intent) {
+            if (Intent.ACTION_USER_UNLOCKED.equals(intent.getAction()) &&
+                    intent.getIntExtra(Intent.EXTRA_USER_HANDLE, UserHandle.USER_NULL) == UserHandle.USER_SYSTEM) {
+                mHandler.post(() -> {
+                    synchronized (mStateLock) {
+                        mUserAvailable = true;
+                        bindProviderAfterUserAvailable();
+                    }
+                });
+            }
+        }
+    };
+
+    private final DisplayManager.DisplayListener mDisplayListener =
+            new DisplayManager.DisplayListener() {
+        @Override public void onDisplayAdded(int displayId) { }
+
+        @Override public void onDisplayRemoved(int displayId) { }
+
+        @Override public void onDisplayChanged(int displayId) {
+            if (displayId == Display.DEFAULT_DISPLAY) observeDefaultDisplayState();
+        }
+    };
+
+    private void observeDefaultDisplayState() {
+        final Display display = mDisplayManager.getDisplay(Display.DEFAULT_DISPLAY);
+        if (display == null) return;
+        final int state = display.getState();
+        boolean refreshCatalog = false;
+        synchronized (mStateLock) {
+            final int previous = mDefaultDisplayState;
+            if (previous == state) return;
+            mDefaultDisplayState = state;
+            if (previous == DISPLAY_STATE_UNINITIALIZED) return;
+            if (previous != Display.STATE_OFF && state == Display.STATE_OFF) {
+                // The authoritative arm is the synchronous pre-OFF handoff
+                // from DisplayPowerController. This observer reconciles only.
+                reconcileScreenOffLocked();
+            } else if (previous == Display.STATE_OFF && state != Display.STATE_OFF) {
+                refreshCatalog = handleScreenOnLocked();
+            }
+        }
+        if (refreshCatalog) requestRetainedCatalog();
+    }
+
+    private final ServiceConnection mProviderConnection = new ServiceConnection() {
+        @Override public void onServiceConnected(ComponentName name, IBinder service) {
+            mHandler.post(() -> {
+                synchronized (mStateLock) {
+                    mProvider = service;
+                    mProviderUid = resolveProviderUid();
+                    mRequestsThisConnection = 0;
+                    requestRetainedCatalog();
+                }
+            });
+        }
+        @Override public void onServiceDisconnected(ComponentName name) {
+            mHandler.post(() -> {
+                synchronized (mStateLock) {
+                    mProvider = null;
+                    mProviderUid = -1;
+                    ++mRequestGeneration;
+                    mRequestInFlight = false;
+                    mRequestsThisConnection = 0;
+                    finishRefreshLocked(RESULT_UNAVAILABLE);
+                }
+            });
+        }
+    };
+
+    private final Neo2SleepImageManagerInternal mLocalService =
+            new Neo2SleepImageManagerInternal() {
+        @Override public void beginDefaultDisplayOff() {
+            synchronized (mStateLock) {
+                beginScreenOffLocked();
+            }
+        }
+
+        @Override public long defaultDisplayOffDelayMillis() {
+            synchronized (mStateLock) {
+                return mPowerOffGuard.remaining(android.os.SystemClock.uptimeMillis());
+            }
+        }
+
+        @Override public void cancelDefaultDisplayOff() {
+            synchronized (mStateLock) {
+                cancelScreenOffLocked();
+            }
+        }
+    };
+
+    // Caller holds mStateLock before policy is told that the default display
+    // is turning off. Mode and catalog state were cached while awake.
+    private void beginScreenOffLocked() {
+        if (mScreenOff) return;
+        mScreenOff = true;
+        mSleepPresentationRequested = false;
+        ++mScreenEdgesReceived;
+        if (mSleepImageMode != MODE_KEEP_LAST_SCREEN) {
+            if (sendEpoch(SF_SCREEN_OFF, mEpoch)) {
+                mSleepPresentationRequested = true;
+                // The legacy Aura HWC stops the controller at OFF even with a CPU wake lock.
+                // Queue acceptance is not panel completion: allow a bounded settling interval.
+                if ("aura_c".equals(android.os.SystemProperties.get(
+                        "ro.neo2.eink.device_variant", ""))) {
+                    mPowerOffGuard.start(android.os.SystemClock.uptimeMillis());
+                }
+                ++mScreenOffEpochDelivered;
+            }
+        } else {
+            if (sendEpoch(SF_SCREEN_ON, mEpoch)) ++mScreenOnEpochDelivered;
+        }
+        logAsyncDiagnostics();
+    }
+
+    // Caller holds mStateLock when Android abandons turning off before an OFF
+    // edge. Withdraw a pending direct candidate and resume ordinary capture.
+    private void cancelScreenOffLocked() {
+        if (!mScreenOff) return;
+        final boolean renewEpoch = mSleepPresentationRequested;
+        ++mScreenEdgesReceived;
+        if (mSleepPresentationRequested && sendEpoch(SF_SCREEN_ON, mEpoch)) {
+            ++mScreenOnEpochDelivered;
+        }
+        mSleepPresentationRequested = false;
+        mPowerOffGuard.cancel();
+        mScreenOff = false;
+        // Cancellation never produces a display OFF/ON edge. Renew the consumed epoch
+        // from our retained descriptors now, so even an immediate second sleep works.
+        // This does not decode images or wait on the application provider.
+        if (renewEpoch) {
+            ArrayList<Candidate> publication = copyRetainedCatalog();
+            if (publication != null && !publication.isEmpty()) {
+                int selected = selectCandidateIndex(publication);
+                if (selected >= 0) {
+                    ++mSelections;
+                    if (publication.get(selected).fallback) ++mFallbackSelections;
+                    recordEndpointResult(sendCatalog(++mEpoch, publication,
+                            selected, mSleepImageMode));
+                } else {
+                    closeAll(publication);
+                }
+            } else {
+                closeAll(publication);
+            }
+        }
+        logAsyncDiagnostics();
+    }
+
+    // Caller holds mStateLock after observing OFF. Never arm here: this path
+    // also handles startup while already OFF and a missing pre-OFF service.
+    private void reconcileScreenOffLocked() {
+        if (mScreenOff) return;
+        mScreenOff = true;
+        ++mScreenEdgesReceived;
+        logAsyncDiagnostics();
+    }
+
+    private void refreshSleepImageMode() {
+        int mode = Settings.Global.getInt(getContext().getContentResolver(),
+                MODE_SETTING, MODE_SLEEP_IMAGE);
+        if (!validSleepImageMode(mode)) {
+            mode = MODE_SLEEP_IMAGE;
+        }
+        synchronized (mStateLock) {
+            if (mode == mSleepImageMode) return;
+            mSleepImageMode = mode;
+            ++mRequestGeneration;
+            mRequestInFlight = false;
+            mRequestsThisConnection = 0;
+            ArrayList<Candidate> previous = mRetainedCatalog;
+            mRetainedCatalog = new ArrayList<>();
+            closeAll(previous);
+            if (!mScreenOff && mode != MODE_KEEP_LAST_SCREEN) {
+                requestRetainedCatalog();
+            }
+        }
+    }
+
+    private static boolean validSleepImageMode(int mode) {
+        return mode == MODE_KEEP_LAST_SCREEN || mode == MODE_SLEEP_IMAGE ||
+                mode == MODE_OVERLAY_SLEEP_IMAGE || mode == MODE_KOREADER_COVER;
+    }
+
+    private void writeSleepImageMode(int mode) {
+        if (!Settings.Global.putInt(getContext().getContentResolver(), MODE_SETTING, mode)) {
+            Slog.w(TAG, "Sleep image mode write was rejected");
+            return;
+        }
+    }
+
+    private final IBinder mControlService = new Binder() {
+        @Override protected boolean onTransact(int code, Parcel data, Parcel reply, int flags) {
+            if ((code != CONTROL_SET_MODE && code != CONTROL_REFRESH_CATALOG) ||
+                    (flags & IBinder.FLAG_ONEWAY) != 0) return false;
+            data.enforceInterface(CONTROL_DESCRIPTOR);
+            getContext().enforceCallingPermission(CONTROL_PERMISSION,
+                    "Managing Neo2 sleep images requires MANAGE_SLEEP_IMAGES");
+            if (code == CONTROL_REFRESH_CATALOG) {
+                final long storeGeneration = data.readLong();
+                final IBinder callback = data.readStrongBinder();
+                data.enforceNoDataAvail();
+                if (storeGeneration <= 0 || callback == null) {
+                    throw new IllegalArgumentException("Invalid catalog refresh request");
+                }
+                synchronized (mStateLock) {
+                    if (mScreenOff || !mUserAvailable || mProvider == null || mProviderUid < 0) {
+                        reply.writeNoException();
+                        reply.writeInt(RESULT_UNAVAILABLE);
+                        return true;
+                    }
+                    finishRefreshLocked(RESULT_UNAVAILABLE);
+                    mPendingStoreGeneration = storeGeneration;
+                    mPendingRefreshCallback = callback;
+                    ++mRequestGeneration;
+                    mRequestInFlight = false;
+                    mRequestsThisConnection = 0;
+                    requestRetainedCatalog();
+                }
+                reply.writeNoException();
+                reply.writeInt(RESULT_OK);
+                return true;
+            }
+            final int mode = data.readInt();
+            data.enforceNoDataAvail();
+            if (!validSleepImageMode(mode)) {
+                throw new IllegalArgumentException("Unsupported sleep image mode");
+            }
+            mHandler.post(() -> writeSleepImageMode(mode));
+            reply.writeNoException();
+            reply.writeInt(CONTROL_RESULT_QUEUED);
+            return true;
+        }
+    };
+
+    // Caller holds mStateLock after the matching default-display ON edge.
+    private boolean handleScreenOnLocked() {
+        if (!mScreenOff) return false;
+        ++mScreenEdgesReceived;
+        if (mSleepPresentationRequested && sendEpoch(SF_SCREEN_ON, mEpoch)) {
+            ++mScreenOnEpochDelivered;
+        }
+        mSleepPresentationRequested = false;
+        mPowerOffGuard.cancel();
+        mScreenOff = false;
+        ++mRequestGeneration;
+        mRequestInFlight = false;
+        mRequestsThisConnection = 0;
+        logAsyncDiagnostics();
+        return true;
+    }
+
+    // The only provider request is one-way and only issued while the display
+    // is on. Screen-off neither performs provider I/O nor waits for a result.
+    private void requestRetainedCatalog() {
+        synchronized (mStateLock) {
+            if (mScreenOff || !mUserAvailable || mProvider == null || mProviderUid < 0 ||
+                    mRequestInFlight || mRequestsThisConnection >= MAXIMUM_REQUESTS_PER_CONNECTION) return;
+            final long generation = ++mRequestGeneration;
+            Parcel data = Parcel.obtain();
+            mRequestInFlight = true;
+            ++mRequestsIssued;
+            ++mRequestsThisConnection;
+            try {
+                data.writeInterfaceToken(PROVIDER_DESCRIPTOR);
+                data.writeInt(PROVIDER_PROTOCOL_VERSION);
+                data.writeLong(generation);
+                data.writeInt(mSleepImageMode);
+                data.writeStrongBinder(mProviderCallback);
+                if (!mProvider.transact(PROVIDER_REQUEST_CATALOG, data, null, IBinder.FLAG_ONEWAY)) {
+                    mRequestInFlight = false;
+                    ++mRequestTransportFailures;
+                    finishRefreshLocked(RESULT_UNAVAILABLE);
+                } else {
+                    mHandler.postDelayed(() -> handleRequestTimeout(generation), REQUEST_TIMEOUT_MILLIS);
+                }
+            } catch (RemoteException | RuntimeException e) {
+                mRequestInFlight = false;
+                ++mRequestTransportFailures;
+                finishRefreshLocked(RESULT_UNAVAILABLE);
+            } finally {
+                data.recycle();
+                logAsyncDiagnostics();
+            }
+        }
+    }
+
+    // A one-way Binder acceptance has no reply. Limit recovery to one additional
+    // request per provider connection/screen-on interval so a lost callback cannot
+    // hold the retained catalog hostage or create an unbounded retry loop.
+    private void handleRequestTimeout(long generation) {
+        synchronized (mStateLock) {
+            if (!mRequestInFlight || generation != mRequestGeneration) return;
+            mRequestInFlight = false;
+            ++mRequestTimeouts;
+            if (!mScreenOff) requestRetainedCatalog();
+            if (mScreenOff ||
+                    (!mRequestInFlight && mRequestsThisConnection >= MAXIMUM_REQUESTS_PER_CONNECTION)) {
+                finishRefreshLocked(RESULT_UNAVAILABLE);
+            }
+            logAsyncDiagnostics();
+        }
+    }
+
+    private int resolveProviderUid() {
+        try {
+            return getContext().getPackageManager().getPackageUid(PROVIDER_PACKAGE, 0);
+        } catch (PackageManager.NameNotFoundException e) {
+            return -1;
+        }
+    }
+
+    private final IBinder mProviderCallback = new Binder() {
+        @Override protected boolean onTransact(int code, Parcel data, Parcel reply, int flags) {
+            if (code != PROVIDER_RESULT_CATALOG || (flags & IBinder.FLAG_ONEWAY) == 0 ||
+                    Binder.getCallingUid() != mProviderUid) {
+                mHandler.post(() -> {
+                    synchronized (mStateLock) {
+                        ++mCallbackWrongCaller;
+                        logAsyncDiagnostics();
+                    }
+                });
+                return false;
+            }
+            long generation = 0;
+            ArrayList<Candidate> candidates = new ArrayList<>();
+            boolean fdFailure = false;
+            try {
+                data.enforceInterface(CALLBACK_DESCRIPTOR);
+                if (data.readInt() != PROVIDER_PROTOCOL_VERSION || (generation = data.readLong()) <= 0) {
+                    throw new IllegalArgumentException();
+                }
+                final long storeGeneration = data.readLong();
+                if (storeGeneration <= 0) throw new IllegalArgumentException();
+                final int result = data.readInt();
+                final int reason = data.readInt();
+                final int count = data.readInt();
+                if (count < 0 || count > MAXIMUM_ENTRIES || !validProviderResult(result, reason, count)) {
+                    throw new IllegalArgumentException();
+                }
+                if (result == RESULT_OK) {
+                    int[] widths = new int[count];
+                    int[] heights = new int[count];
+                    for (int index = 0; index < count; ++index) {
+                        int fallback = data.readInt();
+                        int eligible = data.readInt();
+                        int width = data.readInt();
+                        int height = data.readInt();
+                        widths[index] = width;
+                        heights[index] = height;
+                        int panelBytes = Neo2SleepImageGeometry.panelBytesFor(width, height);
+                        if ((fallback != 0 && fallback != 1) ||
+                                (eligible != 0 && eligible != 1) ||
+                                panelBytes <= 0) {
+                            throw new IllegalArgumentException();
+                        }
+                        ParcelFileDescriptor grayTransport = data.readFileDescriptor();
+                        ParcelFileDescriptor alphaTransport = data.readFileDescriptor();
+                        ParcelFileDescriptor grayFd = null;
+                        ParcelFileDescriptor alphaFd = null;
+                        try {
+                            grayFd = duplicateValidatedSharedMemory(grayTransport, Math.multiplyExact(panelBytes, 4));
+                            alphaFd = duplicateValidatedSharedMemory(alphaTransport, panelBytes);
+                        } catch (java.io.IOException | RuntimeException e) {
+                            try { if (grayFd != null) grayFd.close(); }
+                            catch (java.io.IOException ignored) { }
+                            try { if (alphaFd != null) alphaFd.close(); }
+                            catch (java.io.IOException ignored) { }
+                            fdFailure = true;
+                            throw e;
+                        }
+                        if (grayFd == null || alphaFd == null) {
+                            if (grayFd != null) grayFd.close();
+                            if (alphaFd != null) alphaFd.close();
+                            throw new IllegalArgumentException();
+                        }
+                        candidates.add(new Candidate(grayFd, alphaFd,
+                                width, height, fallback == 1, eligible == 1));
+                    }
+                    if (!Neo2SleepImageGeometry.isHomogeneousExpected(widths, heights) ||
+                            !validCandidateMetadata(candidates)) {
+                        throw new IllegalArgumentException();
+                    }
+                }
+                if (data.dataAvail() != 0) throw new IllegalArgumentException();
+                final long callbackGeneration = generation;
+                mHandler.post(() -> handleProviderCallback(callbackGeneration, storeGeneration,
+                        result, candidates, true, false));
+            } catch (java.io.IOException | RuntimeException e) {
+                closeAll(candidates);
+                final long callbackGeneration = generation;
+                final boolean callbackFdFailure = fdFailure;
+                mHandler.post(() -> handleProviderCallback(callbackGeneration, 0,
+                        RESULT_UNAVAILABLE, null, false, callbackFdFailure));
+            }
+            return true;
+        }
+    };
+
+    private static boolean validProviderResult(int result, int reason, int count) {
+        return (result == RESULT_OK && reason == REASON_NONE && count > 0) ||
+                (result == RESULT_UNAVAILABLE && count == 0 &&
+                        (reason == REASON_STORE_IO || reason == REASON_SHARED_MEMORY)) ||
+                (result == RESULT_EMPTY && reason == REASON_NO_VALID_CANDIDATE && count == 0);
+    }
+
+    private static boolean validCandidateMetadata(ArrayList<Candidate> candidates) {
+        int fallbackCount = 0;
+        int eligibleCount = 0;
+        int width = candidates.isEmpty() ? -1 : candidates.get(0).width;
+        int height = candidates.isEmpty() ? -1 : candidates.get(0).height;
+        for (Candidate candidate : candidates) {
+            if (candidate.width != width || candidate.height != height) return false;
+            if (candidate.fallback) ++fallbackCount;
+            if (candidate.eligible) ++eligibleCount;
+        }
+        return fallbackCount == 1 && eligibleCount > 0;
+    }
+
+    private static ParcelFileDescriptor duplicateValidatedSharedMemory(
+            ParcelFileDescriptor transport, int expectedBytes) throws java.io.IOException {
+        if (transport == null) throw new java.io.IOException("missing shared memory");
+        SharedMemory memory = null;
+        try {
+            memory = SharedMemory.fromFileDescriptor(transport);
+            transport = null; // SharedMemory owns the detached transport descriptor.
+            if (memory.getSize() != expectedBytes) {
+                throw new java.io.IOException("wrong shared memory size");
+            }
+            return ParcelFileDescriptor.dup(memory.getFileDescriptor());
+        } finally {
+            if (memory != null) memory.close();
+            else if (transport != null) transport.close();
+        }
+    }
+
+    private void handleProviderCallback(long generation, long storeGeneration, int result,
+            ArrayList<Candidate> candidates, boolean valid, boolean fdFailure) {
+        synchronized (mStateLock) {
+          if (!valid) {
+            ++mCallbackInvalid;
+            if (fdFailure) ++mCallbackFdFailures;
+            // A malformed callback from the expected provider may fail before its
+            // generation is readable. Clear only the current request; caller and
+            // screen-off checks remain enforced by the Binder boundary above.
+            if (generation == 0 || generation == mRequestGeneration) mRequestInFlight = false;
+            closeAll(candidates);
+            if (generation == 0 || generation == mRequestGeneration) {
+                finishRefreshLocked(RESULT_UNAVAILABLE);
+            }
+            logAsyncDiagnostics();
+              return;
+          }
+          if (generation != mRequestGeneration) {
+            ++mCallbackStale;
+            closeAll(candidates);
+            logAsyncDiagnostics();
+              return;
+          }
+          mRequestInFlight = false;
+          if (result == RESULT_OK) ++mProviderResultOk;
+          else if (result == RESULT_EMPTY) ++mProviderResultEmpty;
+          else ++mProviderResultUnavailable;
+          if (mScreenOff) {
+            ++mCallbackScreenOff;
+            closeAll(candidates);
+            finishRefreshLocked(RESULT_UNAVAILABLE);
+            logAsyncDiagnostics();
+              return;
+          }
+          ++mCallbackAccepted;
+          if (mPendingRefreshCallback != null &&
+                  (result != RESULT_OK || storeGeneration != mPendingStoreGeneration)) {
+            closeAll(candidates);
+            finishRefreshLocked(RESULT_UNAVAILABLE);
+            logAsyncDiagnostics();
+            return;
+          }
+          if (result == RESULT_OK) {
+            ArrayList<Candidate> previous = mRetainedCatalog;
+            mRetainedCatalog = candidates;
+            ++mRetainedCatalogUpdates;
+            // Retained descriptors remain manager-owned. sendCatalog closes
+            // only this per-publication duplicate under its existing contract.
+            ArrayList<Candidate> publication = copyRetainedCatalog();
+            if (mSleepImageMode == MODE_KEEP_LAST_SCREEN) {
+                closeAll(publication);
+            } else if (publication != null && !publication.isEmpty()) {
+                int selected = selectCandidateIndex(publication);
+                if (selected >= 0) {
+                    ++mSelections;
+                    if (publication.get(selected).fallback) ++mFallbackSelections;
+                    recordEndpointResult(sendCatalog(++mEpoch, publication,
+                            selected, mSleepImageMode));
+                } else {
+                    closeAll(publication);
+                    ++mBlackFallbacks;
+                }
+            } else {
+                closeAll(publication);
+                ++mBlackFallbacks;
+            }
+            closeAll(previous);
+            if (storeGeneration == mPendingStoreGeneration) finishRefreshLocked(RESULT_OK);
+          } else {
+            closeAll(candidates);
+          }
+          logAsyncDiagnostics();
+        }
+    }
+
+    // Caller holds mStateLock. The app receives store durability separately;
+    // this one-way result reports only retained-catalog synchronization.
+    private void finishRefreshLocked(int result) {
+        IBinder callback = mPendingRefreshCallback;
+        long storeGeneration = mPendingStoreGeneration;
+        mPendingRefreshCallback = null;
+        mPendingStoreGeneration = 0;
+        if (callback == null) return;
+        Parcel data = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(REFRESH_CALLBACK_DESCRIPTOR);
+            data.writeLong(storeGeneration);
+            data.writeInt(result);
+            callback.transact(REFRESH_CALLBACK_RESULT, data, null, IBinder.FLAG_ONEWAY);
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Sleep-image refresh result delivery failed");
+        } finally {
+            data.recycle();
+        }
+    }
+
+    private ArrayList<Candidate> copyRetainedCatalog() {
+        ArrayList<Candidate> copy = new ArrayList<>(mRetainedCatalog.size());
+        try {
+            for (Candidate candidate : mRetainedCatalog) {
+                copy.add(new Candidate(
+                        ParcelFileDescriptor.dup(candidate.grayFd.getFileDescriptor()),
+                        ParcelFileDescriptor.dup(candidate.alphaFd.getFileDescriptor()),
+                        candidate.width, candidate.height,
+                        candidate.fallback, candidate.eligible));
+            }
+            return copy;
+        } catch (java.io.IOException e) {
+            closeAll(copy);
+            Slog.w(TAG, "Sleep-image retained catalog unavailable");
+            return null;
+        }
+    }
+
+    private int selectCandidateIndex(ArrayList<Candidate> catalog) {
+        ArrayList<Integer> eligible = new ArrayList<>();
+        int fallback = -1;
+        for (int index = 0; index < catalog.size(); ++index) {
+            Candidate candidate = catalog.get(index);
+            if (candidate.fallback) fallback = index;
+            if (candidate.eligible) eligible.add(index);
+        }
+        if (!eligible.isEmpty()) return eligible.get(mRandom.nextInt(eligible.size()));
+        return fallback;
+    }
+
+    private void recordEndpointResult(boolean accepted) {
+        if (accepted) ++mEndpointAccepted;
+        else {
+            ++mEndpointRejected;
+            ++mBlackFallbacks;
+        }
+        logAsyncDiagnostics();
+    }
+
+    // Aggregate-only diagnostics: no names, paths, descriptors, image bytes,
+    // or completion implication crosses this boundary.
+    private void logAsyncDiagnostics() {
+        Slog.i(TAG, "Sleep-image async request=" + mRequestsIssued + "/" +
+                mRequestTransportFailures + "/" + mRequestTimeouts + " provider=" + mProviderResultOk + "/" +
+                mProviderResultUnavailable + "/" + mProviderResultEmpty + " callback=" +
+                mCallbackAccepted + "/" + mCallbackInvalid + "/" + mCallbackStale + "/" +
+                mCallbackWrongCaller + "/" + mCallbackScreenOff + "/" + mCallbackFdFailures + " retained=" +
+                mRetainedCatalogUpdates + " endpoint=" + mEndpointAccepted + "/" +
+                mEndpointRejected + " selection=" + mSelections + " black_fallback=" +
+                mBlackFallbacks + " source_fallback=" + mFallbackSelections + " edge=" +
+                mScreenEdgesReceived + "/" +
+                mScreenOffEpochDelivered + "/" + mScreenOnEpochDelivered +
+                " sleep_epoch=" + mEpoch +
+                " presentation_requested=" + mSleepPresentationRequested);
+    }
+
+    private boolean sendEpoch(int transaction, long epoch) {
+        IBinder endpoint = ServiceManager.getService(SF_SERVICE);
+        if (endpoint == null) return false;
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(SF_DESCRIPTOR);
+            data.writeInt(SF_PROTOCOL_VERSION);
+            data.writeLong(epoch);
+            if (!endpoint.transact(transaction, data, reply, 0)) return false;
+            reply.readException();
+            return reply.readInt() == SF_PROTOCOL_VERSION && reply.readInt() == RESULT_OK;
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Sleep-image epoch delivery failed");
+            return false;
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+
+    private boolean sendCatalog(long epoch, ArrayList<Candidate> catalog, int selected, int mode) {
+        IBinder endpoint = ServiceManager.getService(SF_SERVICE);
+        if (endpoint == null) { closeAll(catalog); return false; }
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(SF_DESCRIPTOR);
+            data.writeInt(SF_PROTOCOL_VERSION);
+            data.writeLong(epoch);
+            data.writeInt(catalog.size());
+            data.writeInt(selected);
+            data.writeInt(mode == MODE_KOREADER_COVER ? MODE_SLEEP_IMAGE : mode);
+            for (Candidate candidate : catalog) {
+                data.writeInt(candidate.width);
+                data.writeInt(candidate.height);
+                data.writeFileDescriptor(candidate.grayFd.getFileDescriptor());
+                data.writeFileDescriptor(candidate.alphaFd.getFileDescriptor());
+            }
+            if (!endpoint.transact(SF_PUBLISH, data, reply, 0)) return false;
+            reply.readException();
+            if (reply.readInt() != SF_PROTOCOL_VERSION || reply.readInt() != RESULT_OK) {
+                Slog.w(TAG, "Sleep-image catalog endpoint rejected");
+                return false;
+            }
+            return true;
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Sleep-image catalog delivery failed");
+            return false;
+        } finally {
+            closeAll(catalog);
+            reply.recycle();
+            data.recycle();
+        }
+    }
+
+    private static void closeAll(ArrayList<Candidate> catalog) {
+        if (catalog == null) return;
+        for (Candidate candidate : catalog) {
+            try { candidate.grayFd.close(); } catch (java.io.IOException ignored) { }
+            try { candidate.alphaFd.close(); } catch (java.io.IOException ignored) { }
+        }
+    }
+
+    private static final class Candidate {
+        final ParcelFileDescriptor grayFd;
+        final ParcelFileDescriptor alphaFd;
+        final int width;
+        final int height;
+        final boolean fallback;
+        final boolean eligible;
+        Candidate(ParcelFileDescriptor grayFd, ParcelFileDescriptor alphaFd,
+                int width, int height, boolean fallback, boolean eligible) {
+            this.grayFd = grayFd;
+            this.alphaFd = alphaFd;
+            this.width = width;
+            this.height = height;
+            this.fallback = fallback;
+            this.eligible = eligible;
+        }
+    }
+}
