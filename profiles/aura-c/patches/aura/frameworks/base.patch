@@ -0,0 +1,20 @@
+package com.android.server.neo2;
+
+/** Bounded Aura panel dwell, not a physical-completion detector. Caller serializes access. */
+public final class Neo2SleepImagePowerOffGuard {
+    public static final long SETTLE_MILLIS = 2000;
+    private long deadline = -1;
+
+    public void start(long now) {
+        if (now < 0 || now > Long.MAX_VALUE - SETTLE_MILLIS) {
+            throw new IllegalArgumentException("invalid monotonic time");
+        }
+        deadline = now + SETTLE_MILLIS;
+    }
+
+    public long remaining(long now) {
+        return deadline < 0 ? 0 : Math.max(0, Math.min(SETTLE_MILLIS, deadline - now));
+    }
+
+    public void cancel() { deadline = -1; }
+}
