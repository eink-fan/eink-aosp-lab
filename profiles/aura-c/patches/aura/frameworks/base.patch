+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ */
+package com.android.server.neo2;
+
+/** System-server-only default-display power-intent handoff. */
+public abstract class Neo2SleepImageManagerInternal {
+    /** Called once before the policy turning-off callback and fade. */
+    public abstract void beginDefaultDisplayOff();
+
+    /** Remaining bounded panel-settle time; zero when no accepted sleep image is pending. */
+    public abstract long defaultDisplayOffDelayMillis();
+
+    /** Called when that turning-off intent is abandoned before real OFF. */
+    public abstract void cancelDefaultDisplayOff();
+}
