+package com.android.server.neo2;
+
+/**
+ * Build-profile-bound Aura C sleep-image geometry.
+ *
+ * Catalog planes are panel-facing 2480x1860 grayscale/alpha buffers. The
+ * separate 3840x1280 Kaleido electrical layout is a vendor CFA output and is
+ * never accepted as catalog transport geometry.
+ */
+final class Neo2SleepImageGeometry {
+    static final int PANEL_WIDTH = 2480;
+    static final int PANEL_HEIGHT = 1860;
+    static final int PANEL_BYTES = 4_612_800;
+
+    private Neo2SleepImageGeometry() { }
+
+    static int panelBytesFor(int width, int height) {
+        return width == PANEL_WIDTH && height == PANEL_HEIGHT ? PANEL_BYTES : -1;
+    }
+
+    static boolean isHomogeneousExpected(int[] widths, int[] heights) {
+        if (widths == null || heights == null || widths.length == 0 ||
+                widths.length != heights.length) {
+            return false;
+        }
+        for (int index = 0; index < widths.length; ++index) {
+            if (panelBytesFor(widths[index], heights[index]) != PANEL_BYTES) {
+                return false;
+            }
+        }
+        return true;
+    }
+}
