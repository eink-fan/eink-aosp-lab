@@ -0,0 +1,14 @@
+package com.android.server.neo2;
+
+/** Identifies the Aura internal keypad's synthetic charger wake scan code. */
+public final class AuraChargerWakePolicy {
+    private AuraChargerWakePolicy() {}
+
+    // Only call for KEYCODE_WAKEUP. Power, cover and other input paths are unchanged.
+    public static boolean shouldIgnore(String variant, String name, int vendorId,
+            int productId, boolean external, int scanCode) {
+        return "aura_c".equals(variant) && "mtk-kpd".equals(name)
+                && vendorId == 0x2454 && productId == 0x6500
+                && !external && scanCode == 143;
+    }
+}
