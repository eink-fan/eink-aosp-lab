+import com.android.systemui.plugins.statusbar.StatusBarStateController;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.QsEventLogger;
+import com.android.systemui.qs.logging.QSLogger;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+import com.android.systemui.R;
+
+import javax.inject.Inject;
+
+/** Quick Settings tile for the manager-owned Neo2 front light. */
+public final class Neo2FrontLightTile extends QSTileImpl<QSTile.BooleanState> {
+    public static final String TILE_SPEC = "frontlight";
+    private static final long REQUEST_REFRESH_MILLIS = 50;
+
+    @Nullable private final Neo2FrontLightManager mManager;
+    private final Handler mMainHandler;
+
+    @Inject
+    public Neo2FrontLightTile(
+            QSHost host,
+            QsEventLogger uiEventLogger,
+            @Background Looper backgroundLooper,
+            @Main Handler mainHandler,
+            FalsingManager falsingManager,
+            MetricsLogger metricsLogger,
+            StatusBarStateController statusBarStateController,
+            ActivityStarter activityStarter,
+            QSLogger qsLogger) {
+        super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager, metricsLogger,
+                statusBarStateController, activityStarter, qsLogger);
+        mManager = Neo2FrontLightManager.connect();
+        mMainHandler = mainHandler;
+    }
+
+    @Override
+    public boolean isAvailable() {
+        return mManager != null && mContext.getResources().getBoolean(
+                R.bool.config_neo2_use_frontlight_brightness_slider);
+    }
+
+    @Override
+    public BooleanState newTileState() {
+        return new BooleanState();
+    }
+
+    @Override
+    protected void handleClick(@Nullable View view) {
+        if (mManager == null) return;
+        Neo2FrontLightManager.State state = mManager.getState();
+        if (state.available) {
+            mManager.setEnabled(!state.enabled);
+            refreshState();
+            mMainHandler.postDelayed(this::refreshState, REQUEST_REFRESH_MILLIS);
+        }
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        return new Intent(Intent.ACTION_SHOW_BRIGHTNESS_DIALOG)
+                .setPackage(mContext.getPackageName());
+    }
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        Neo2FrontLightManager.State managerState =
+                mManager == null ? null : mManager.getState();
+        state.label = mContext.getString(R.string.neo2_frontlight_label);
+        state.expandedAccessibilityClassName = Switch.class.getName();
+        if (managerState == null || !managerState.available) {
+            state.value = false;
+            state.state = Tile.STATE_UNAVAILABLE;
+            state.secondaryLabel = null;
+            state.contentDescription = mContext.getString(
+                    R.string.neo2_frontlight_tile_content_description_unavailable);
+            state.icon = ResourceIcon.get(R.drawable.qs_nightlight_icon_off);
+            return;
+        }
+        boolean enabled = managerState.enabled;
+        state.value = enabled;
+        state.state = enabled ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+        state.secondaryLabel = enabled
+                ? mContext.getString(R.string.neo2_frontlight_tile_summary,
+                        managerState.brightness, managerState.warmth)
+                : mContext.getString(R.string.neo2_frontlight_off);
+        state.contentDescription = mContext.getString(
+                R.string.neo2_frontlight_tile_content_description,
+                state.label, state.secondaryLabel);
+        state.icon = ResourceIcon.get(enabled
+                ? R.drawable.qs_nightlight_icon_on : R.drawable.qs_nightlight_icon_off);
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.neo2_frontlight_label);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return 0;
+    }
+}
