+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ */
+
+package android.neo2;
+
+import android.annotation.Nullable;
+import android.annotation.SuppressLint;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+
+/**
+ * Private Neo2 front-light mediator client.
+ *
+ * @hide
+ */
+@SuppressLint("UnflaggedApi")
+public final class Neo2FrontLightManager {
+    public static final String SERVICE_NAME = "neo2_frontlight";
+    public static final int RESULT_QUEUED = 7;
+    public static final int RESULT_UNAVAILABLE = 3;
+
+    private static final int STATE_ENABLED = 0;
+    private static final int STATE_BRIGHTNESS = 1;
+    private static final int STATE_WARMTH = 2;
+    private static final int STATE_SIZE = 3;
+
+    private final INeo2FrontLightManager mService;
+
+    private Neo2FrontLightManager(INeo2FrontLightManager service) {
+        mService = service;
+    }
+
+    @SuppressLint("ManagerLookup")
+    @Nullable
+    public static Neo2FrontLightManager connect() {
+        IBinder binder = ServiceManager.getService(SERVICE_NAME);
+        if (binder == null) return null;
+        return new Neo2FrontLightManager(INeo2FrontLightManager.Stub.asInterface(binder));
+    }
+
+    public int submitManualRequest(int brightnessPercent, int warmthPercent) {
+        try {
+            return mService.submitManualRequest(brightnessPercent, warmthPercent);
+        } catch (RemoteException e) {
+            return RESULT_UNAVAILABLE;
+        }
+    }
+
+    /** Changes brightness while preserving the manager-owned accepted warmth. */
+    public int submitBrightnessRequest(int brightnessPercent) {
+        try {
+            return mService.submitBrightnessRequest(brightnessPercent);
+        } catch (RemoteException e) {
+            return RESULT_UNAVAILABLE;
+        }
+    }
+
+    /** Changes warmth without replacing the manager-owned brightness. */
+    public int submitWarmthRequest(int warmthPercent) {
+        try {
+            return mService.submitWarmthRequest(warmthPercent);
+        } catch (RemoteException e) {
+            return RESULT_UNAVAILABLE;
+        }
+    }
+
+    /** Enables or disables the front light without discarding the last nonzero pair. */
+    public int setEnabled(boolean enabled) {
+        try {
+            return mService.setEnabled(enabled);
+        } catch (RemoteException e) {
+            return RESULT_UNAVAILABLE;
+        }
+    }
+
+    /** Returns manager-owned desired state. This is not hardware readback. */
+    public State getState() {
+        try {
+            int[] state = mService.getState();
+            if (state == null || state.length != STATE_SIZE) return State.unavailable();
+            return new State(true, state[STATE_ENABLED] != 0,
+                    state[STATE_BRIGHTNESS], state[STATE_WARMTH]);
+        } catch (RemoteException e) {
+            return State.unavailable();
+        }
+    }
+
+    /** Immutable, redacted desired state exposed to trusted native surfaces. */
+    public static final class State {
+        public final boolean available;
+        public final boolean enabled;
+        public final int brightness;
+        public final int warmth;
+
+        public State(boolean available, boolean enabled, int brightness, int warmth) {
+            this.available = available;
+            this.enabled = enabled;
+            this.brightness = brightness;
+            this.warmth = warmth;
+        }
+
+        private static State unavailable() {
+            return new State(false, false, 50, 50);
+        }
+    }
+}
