+package com.android.systemui.settings.brightness;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.neo2.Neo2FrontLightManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.SeekBar;
+import android.widget.Switch;
+import android.widget.TextView;
+
+import com.android.systemui.R;
+
+/** Android 14 View equivalent of the Android 17 manager-backed QS controls. */
+public final class Neo2FrontLightControlsView extends LinearLayout {
+    private final Neo2FrontLightManager mManager = Neo2FrontLightManager.connect();
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Switch mEnabled;
+    private final SeekBar mBrightness;
+    private final SeekBar mWarmth;
+    private final TextView mBrightnessLabel;
+    private final TextView mWarmthLabel;
+    private boolean mRefreshing;
+    private boolean mDragging;
+    private final ContentObserver mObserver = new ContentObserver(mHandler) {
+        @Override public void onChange(boolean selfChange) { refresh(); }
+    };
+
+    public Neo2FrontLightControlsView(Context context) {
+        super(context);
+        setOrientation(VERTICAL);
+        int padding = dp(12);
+        setPadding(padding, padding, padding, padding);
+        setLayoutParams(new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        mEnabled = new Switch(context);
+        mEnabled.setText(R.string.neo2_frontlight_label);
+        mEnabled.setMinHeight(dp(48));
+        addView(mEnabled);
+        mBrightnessLabel = new TextView(context);
+        addView(mBrightnessLabel);
+        mBrightness = slider(R.string.neo2_frontlight_brightness_label);
+        mWarmthLabel = new TextView(context);
+        addView(mWarmthLabel);
+        mWarmth = slider(R.string.neo2_frontlight_warmth_label);
+        mEnabled.setOnCheckedChangeListener((button, checked) -> {
+            if (!mRefreshing && mManager != null) {
+                mManager.setEnabled(checked);
+                mHandler.postDelayed(this::refresh, 50);
+            }
+        });
+        refresh();
+    }
+
+    private SeekBar slider(int label) {
+        SeekBar slider = new SeekBar(getContext());
+        slider.setMax(100);
+        slider.setMinimumHeight(dp(48));
+        slider.setContentDescription(getContext().getString(label));
+        addView(slider, new LayoutParams(LayoutParams.MATCH_PARENT, dp(48)));
+        slider.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override public void onStartTrackingTouch(SeekBar bar) { mDragging = true; }
+            @Override public void onProgressChanged(SeekBar bar, int progress, boolean fromUser) {
+                if (fromUser) {
+                    updateLabels();
+                    // Accessibility/keyboard changes have no drag-stop callback.
+                    if (!mDragging) submit(bar);
+                }
+            }
+            @Override public void onStopTrackingTouch(SeekBar bar) {
+                mDragging = false;
+                submit(bar);
+            }
+        });
+        return slider;
+    }
+
+    private void submit(SeekBar bar) {
+        if (mManager == null) return;
+        if (bar == mBrightness) {
+            mManager.submitBrightnessRequest(bar.getProgress());
+        } else {
+            // Manager reads current brightness on its serialized worker.
+            mManager.submitWarmthRequest(bar.getProgress());
+        }
+        mHandler.postDelayed(this::refresh, 50);
+    }
+
+    private void updateLabels() {
+        mBrightnessLabel.setText(getContext().getString(
+                R.string.neo2_frontlight_value,
+                getContext().getString(R.string.neo2_frontlight_brightness_label),
+                mBrightness.getProgress()));
+        mWarmthLabel.setText(getContext().getString(
+                R.string.neo2_frontlight_value,
+                getContext().getString(R.string.neo2_frontlight_warmth_label),
+                mWarmth.getProgress()));
+    }
+
+    private void refresh() {
+        if (mDragging) return;
+        Neo2FrontLightManager.State state = mManager == null ? null : mManager.getState();
+        boolean available = state != null && state.available;
+        mRefreshing = true;
+        mEnabled.setEnabled(available);
+        mBrightness.setEnabled(available);
+        mWarmth.setEnabled(available);
+        if (available) {
+            mEnabled.setChecked(state.enabled);
+            mBrightness.setProgress(state.brightness);
+            mWarmth.setProgress(state.warmth);
+        }
+        updateLabels();
+        mRefreshing = false;
+    }
+
+    @Override protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        for (String key : new String[] {"neo2_frontlight_enabled",
+                "neo2_frontlight_brightness", "neo2_frontlight_warmth"}) {
+            getContext().getContentResolver().registerContentObserver(
+                    Settings.Secure.getUriFor(key), false, mObserver, UserHandle.USER_SYSTEM);
+        }
+        refresh();
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        getContext().getContentResolver().unregisterContentObserver(mObserver);
+        mHandler.removeCallbacksAndMessages(null);
+        super.onDetachedFromWindow();
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+}
