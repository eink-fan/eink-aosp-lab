diff --git a/private/neo2_sleep_image.te b/private/neo2_sleep_image.te
new file mode 100644
--- /dev/null
+++ b/private/neo2_sleep_image.te
@@ -0,0 +1,15 @@
+# Aura C catalog bytes flow only between the platform-signed Controls provider,
+# system_server's profile-bound validator, and SurfaceFlinger's private endpoint.
+type neo2_sleep_image_service, service_manager_type;
+type neo2_sleep_image_manager_service, service_manager_type;
+
+add_service(surfaceflinger, neo2_sleep_image_service)
+allow system_server neo2_sleep_image_service:service_manager find;
+
+add_service(system_server, neo2_sleep_image_manager_service)
+allow platform_app neo2_sleep_image_manager_service:service_manager find;
+
+# The signature-protected provider and manager exchange only bounded catalog
+# descriptors and refresh results over Binder.
+binder_call(system_server, platform_app)
+binder_call(platform_app, system_server)
diff --git a/private/neo2_frontlight.te b/private/neo2_frontlight.te
new file mode 100644
--- /dev/null
+++ b/private/neo2_frontlight.te
@@ -0,0 +1,18 @@
+# SurfaceFlinger owns the only native Aura C front-light writer. The
+# platform-signed Controls app may discover and call it through its signature
+# permission; no ordinary application is admitted to this Binder boundary.
+type neo2_frontlight_control_service, service_manager_type;
+add_service(surfaceflinger, neo2_frontlight_control_service)
+allow platform_app neo2_frontlight_control_service:service_manager find;
+binder_call(platform_app, surfaceflinger)
+binder_call(surfaceflinger, platform_app)
+
+# Android 17 ownership model: trusted UI -> system_server -> native writer.
+type neo2_frontlight_manager_service, service_manager_type;
+add_service(system_server, neo2_frontlight_manager_service)
+allow platform_app neo2_frontlight_manager_service:service_manager find;
+allow system_app neo2_frontlight_manager_service:service_manager find;
+allow system_server neo2_frontlight_control_service:service_manager find;
+binder_call(system_server, surfaceflinger)
+binder_call(system_app, system_server)
+binder_call(platform_app, system_server)
