 MODULE_BUILD_FROM_SOURCE ?= true
diff --git a/target/product/aosp_arm64_aura_c.mk b/target/product/aosp_arm64_aura_c.mk
new file mode 100644
--- /dev/null
+++ b/target/product/aosp_arm64_aura_c.mk
@@ -0,0 +1,34 @@
+#
