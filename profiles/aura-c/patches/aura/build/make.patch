+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+#
+
+# Preserve the generic ARM64 GSI contract while selecting the measured Aura C
+# profile and its device-owned color runtime.
+NEO2_DEVICE_VARIANT := aura_c
+$(call inherit-product, $(LOCAL_DIR)/aosp_arm64.mk)
+
+# Match the measured stock framework density. The legacy HWC's reported DPI
+# belongs to its nonstandard framebuffer tuple and is not the Android UI density.
+PRODUCT_PRODUCT_PROPERTIES += \
+    ro.sf.lcd_density=420 \
+    ro.boot.vendor.overlay.theme=com.android.internal.systemui.navbar.gestural
+
+PRODUCT_PACKAGES += InkControls
+
+PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
+    system/priv-app/InkControls/%
+
+PRODUCT_NAME := aosp_arm64_aura_c
+PRODUCT_MODEL := AOSP on ARM64 (Musnap Aura C)
