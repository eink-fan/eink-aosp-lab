diff --git a/target/product/aosp_arm64.mk b/target/product/aosp_arm64.mk
--- a/target/product/aosp_arm64.mk
+++ b/target/product/aosp_arm64.mk
@@ -32,14 +32,26 @@
 $(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit.mk)
 $(call inherit-product, $(SRC_TARGET_DIR)/product/generic_system.mk)
 
-# Explicit M4 payload-build gate. This adds only the checksummed RM06L
-# runtime files; it does not link or call the vendor presenter.
-# Never set it for M1–M3 builds.
+NEO2_DEVICE_VARIANT ?= neo2
+ifeq ($(filter $(NEO2_DEVICE_VARIANT),neo2 aura_c),)
+$(error Unsupported NEO2_DEVICE_VARIANT '$(NEO2_DEVICE_VARIANT)')
+endif
+
+SOONG_CONFIG_NAMESPACES += neo2_eink
+SOONG_CONFIG_neo2_eink += device_variant
+SOONG_CONFIG_neo2_eink_device_variant := $(NEO2_DEVICE_VARIANT)
+PRODUCT_PRODUCT_PROPERTIES += \
+    ro.neo2.eink.device_variant=$(NEO2_DEVICE_VARIANT)
+
 ifeq ($(NEO2_M4_RUNTIME_PAYLOAD),true)
+ifeq ($(NEO2_DEVICE_VARIANT),aura_c)
+$(call inherit-product, frameworks/native/services/surfaceflinger/Neo2Eink/android/vendor-runtime/aura_c/aura_c_vendor_runtime_payload.mk)
+else
 $(call inherit-product, frameworks/native/services/surfaceflinger/Neo2Eink/android/vendor-runtime/m4_vendor_runtime_payload.mk)
 endif
+endif
 
-# Enable mainline checking for excat this product name
-ifeq (aosp_arm64,$(TARGET_PRODUCT))
+# Enable mainline checking for the shared Android 14 e-ink product family.
+ifneq ($(filter aosp_arm64 aosp_arm64_aura_c,$(TARGET_PRODUCT)),)
 PRODUCT_ENFORCE_ARTIFACT_PATH_REQUIREMENTS := relaxed
 endif
@@ -65,6 +81,6 @@ $(call inherit-product, $(SRC_TARGET_DIR)/product/non_ab_device.mk)
