+// Neo2 app-private payloads are kept distinct from ordinary partition data so
+// clean-image packaging can preserve executable intent for the few ELF files
+// that their owning applications launch as subprocesses.
+func Neo2PrebuiltAppLibFactory() android.Module {
+	module := &PrebuiltEtc{}
+	InitPrebuiltEtcModule(module, ".")
+	android.InitAndroidArchModule(module, android.DeviceSupported, android.MultilibFirst)
+	android.InitDefaultableModule(module)
+	return module
+}
+
+func Neo2PrebuiltAppExecutableFactory() android.Module {
+	module := &PrebuiltEtc{}
+	InitPrebuiltEtcModule(module, ".")
+	module.installExecutable = true
+	android.InitAndroidArchModule(module, android.DeviceSupported, android.MultilibFirst)
+	android.InitDefaultableModule(module)
+	return module
+}
+
 func defaultsFactory() android.Module {
 	return DefaultsFactory()
 }
