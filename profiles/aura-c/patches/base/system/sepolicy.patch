diff --git a/private/surfaceflinger.te b/private/surfaceflinger.te
index 91e9aba..3630582 100644
--- a/private/surfaceflinger.te
+++ b/private/surfaceflinger.te
@@ -45,6 +45,34 @@ allow surfaceflinger sysfs_gpu:file r_file_perms;
 allow surfaceflinger graphics_device:dir search;
 allow surfaceflinger graphics_device:chr_file rw_file_perms;
 
+# Exact RM06L controller endpoints, intentionally not the generic device type.
+allow surfaceflinger neo2_eink_controller_device:chr_file rw_file_perms;
+
+# The retained engine opens only this attribute write-only during startup.
+# Do not replace this with an allow rule on generic sysfs.
+allow surfaceflinger neo2_eink_pix_fmt_sysfs:file { open write };
+
+# The direct engine reads the board-calibrated VCOM value; do not authorize
+# its separately exported setter or any generic sysfs access.
+allow surfaceflinger neo2_eink_vcom_sysfs:file { getattr open read };
+
+# The retained engine owns this selected-path LUT temperature write. Do not
+# replace it with access to generic thermal/sysfs attributes.
+allow surfaceflinger neo2_eink_temper_info_sysfs:file { open write };
+
+# The disarmed front-light backend performs an access preflight but never
+# writes. An explicitly armed temporary guest may write only these two
+# calibrated primary leaves, not generic sysfs or other LED attributes.
+allow surfaceflinger neo2_frontlight_cool_sysfs:file { getattr open write };
+allow surfaceflinger neo2_frontlight_warm_sysfs:file { getattr open write };
+
+# The kernel-owned waveform loader reads p1/p2 using the caller's credentials.
+# Keep this exact, read-only raw-block access separate from generic block_device.
+allow surfaceflinger neo2_eink_waveform_storage_block_device:blk_file { getattr open read };
+# Traverse the shared /dev/block directory to the two exact typed leaves only.
+allow surfaceflinger block_device:dir search;
+
+
 # Access /dev/video1.
 allow surfaceflinger video_device:dir r_dir_perms;
 allow surfaceflinger video_device:chr_file rw_file_perms;
