+genfscon sysfs /devices/platform/11009000.i2c/i2c-2/2-0036/b_brightness u:object_r:neo2_frontlight_cool_sysfs:s0
+genfscon sysfs /devices/platform/11009000.i2c/i2c-2/2-0036/a_brightness u:object_r:neo2_frontlight_warm_sysfs:s0
