# Editable model-level defaults used with calibration arrays extracted from
# the owner's stock Neo 2. The neutral power values are deliberately bounded;
# builders may copy this file outside Git and pass --frontlight-model to tune
# their local payload without changing this repository.
schema=neo2-frontlight-model-v1
max_power_multiple=1.0
warm_percentage=100
cold_primary_path=/sys/devices/platform/11009000.i2c/i2c-2/2-0036/b_brightness
cold_secondary_path=
warm_primary_path=/sys/devices/platform/11009000.i2c/i2c-2/2-0036/a_brightness
warm_secondary_path=
