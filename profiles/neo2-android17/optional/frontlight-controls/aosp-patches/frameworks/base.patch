+    private static final String CONTROL_DESCRIPTOR = "org.neo2.controls.IFrontLightControl";
+    private static final String CONTROL_PERMISSION =
+            "org.neo2.controls.permission.CONTROL_FRONTLIGHT";
+    private static final int CONTROL_TRANSACTION = IBinder.FIRST_CALL_TRANSACTION;
+    private static final int RESULT_APPLIED = 0;
+    private static final int RESULT_CAPPED = 1;
+    private static final int RESULT_OFF = 2;
+    private static final int RESULT_UNAVAILABLE = 3;
+    private static final int RESULT_REJECTED = 4;
+    private static final int RESULT_FAILED = 5;
+    private static final int RESULT_FAILURE_LATCHED = 6;
+    static final int INITIAL_BRIGHTNESS = 50;
+    static final int INITIAL_WARMTH = 50;
+    private static final String INITIALIZATION_MARKER =
+            "neo2_frontlight_initialized";
+    private static final String STATE_PRESENT = "neo2_frontlight_state_present";
+    private static final String STATE_ENABLED = "neo2_frontlight_enabled";
+    private static final String STATE_BRIGHTNESS = "neo2_frontlight_brightness";
+    private static final String STATE_WARMTH = "neo2_frontlight_warmth";
+    private static final String STATE_LAST_BRIGHTNESS = "neo2_frontlight_last_brightness";
+    private static final String STATE_LAST_WARMTH = "neo2_frontlight_last_warmth";
+
+    private final HandlerThread mWorkerThread = new HandlerThread(TAG);
+    private final Handler mHandler;
+    private final DisplayManager mDisplayManager;
+    private final AtomicLong mLatestGeneration = new AtomicLong();
+    private long mScreenEpoch;
+    private long mCompletedOffEpoch = -1;
+    private boolean mDisplayOn;
+    private boolean mSetupComplete;
+    private boolean mStateLoaded;
+    private boolean mWakeRestorePending;
+    private boolean mDrainScheduled;
+    private Request mPending;
+    private boolean mEnabled = true;
+    private int mDesiredBrightness = INITIAL_BRIGHTNESS;
+    private int mDesiredWarmth = INITIAL_WARMTH;
+    private int mLastBrightness = INITIAL_BRIGHTNESS;
+    private int mLastWarmth = INITIAL_WARMTH;
+    private volatile PublishedState mPublishedState =
+            new PublishedState(true, INITIAL_BRIGHTNESS, INITIAL_WARMTH);
+    private final InitializationTracker mInitialization = new InitializationTracker();
+    private final ContentObserver mSetupObserver;
+
+    public Neo2FrontLightManagerService(Context context) {
+        super(context);
+        mWorkerThread.start();
+        mHandler = new Handler(mWorkerThread.getLooper());
+        mDisplayManager = context.getSystemService(DisplayManager.class);
+        mSetupObserver = new ContentObserver(mHandler) {
+            @Override
+            public void onChange(boolean selfChange, Uri uri) {
+                handleSetupStateChanged();
+            }
+        };
+    }
+
+    @Override
+    public void onStart() {
+        publishBinderService(Neo2FrontLightManager.SERVICE_NAME, new BinderService());
+    }
+
+    @Override
+    public void onBootPhase(int phase) {
+        if (phase != SystemService.PHASE_SYSTEM_SERVICES_READY) {
+            return;
+        }
+        getContext().getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(Settings.Secure.USER_SETUP_COMPLETE), false,
+                mSetupObserver, UserHandle.USER_SYSTEM);
+        mDisplayManager.registerDisplayListener(
+                mDisplayListener, mHandler, DisplayManager.EVENT_TYPE_DISPLAY_STATE);
+        mHandler.post(this::loadState);
+    }
+
+    private final DisplayManager.DisplayListener mDisplayListener =
+            new DisplayManager.DisplayListener() {
+        @Override
+        public void onDisplayAdded(int displayId) {}
+
+        @Override
+        public void onDisplayRemoved(int displayId) {}
+
+        @Override
+        public void onDisplayChanged(int displayId) {
+            if (displayId != Display.DEFAULT_DISPLAY) return;
+            handleDisplayState(readDisplayOn());
+        }
+    };
+
+    private final class BinderService extends INeo2FrontLightManager.Stub {
+        @Override
+        public int submitManualRequest(int brightnessPercent, int warmthPercent) {
+            enforceManagerAccess();
+            if (!isPercent(brightnessPercent) || !isPercent(warmthPercent)) {
+                return RESULT_REJECTED;
+            }
+            long generation = mLatestGeneration.incrementAndGet();
+            mHandler.post(() -> queueManual(generation, brightnessPercent, warmthPercent));
+            return Neo2FrontLightManager.RESULT_QUEUED;
+        }
+
+        @Override
+        public int submitBrightnessRequest(int brightnessPercent) {
+            enforceManagerAccess();
+            if (!isPercent(brightnessPercent)) return RESULT_REJECTED;
+            long generation = mLatestGeneration.incrementAndGet();
+            mHandler.post(() -> queueBrightness(generation, brightnessPercent));
+            return Neo2FrontLightManager.RESULT_QUEUED;
+        }
+
+        @Override
+        public int setEnabled(boolean enabled) {
+            enforceManagerAccess();
+            long generation = mLatestGeneration.incrementAndGet();
+            mHandler.post(() -> queueEnabled(generation, enabled));
+            return Neo2FrontLightManager.RESULT_QUEUED;
+        }
+
+        @Override
+        public int[] getState() {
+            enforceManagerAccess();
+            return mPublishedState.toArray();
+        }
+
+        private void enforceManagerAccess() {
+            if (Binder.getCallingUid() != Process.SYSTEM_UID) {
+                getContext().enforceCallingOrSelfPermission(CONTROL_PERMISSION, TAG);
+            }
+        }
+    }
+
+    private void queueManual(long generation, int brightness, int warmth) {
+        if (generation != mLatestGeneration.get()) return;
+        updateDesired(brightness, warmth);
+        queueDesiredOrOff(generation, Request.KIND_MANUAL);
+    }
+
+    private void queueBrightness(long generation, int brightness) {
+        if (generation != mLatestGeneration.get()) return;
+        Request request = nativeBrightnessRequest(generation, brightness, mDesiredWarmth);
+        updateDesired(request.brightness, request.warmth);
+        queueDesiredOrOff(generation, Request.KIND_BRIGHTNESS);
+    }
+
+    private void queueEnabled(long generation, boolean enabled) {
+        if (generation != mLatestGeneration.get()) return;
+        mEnabled = enabled;
+        persistState();
+        publishState();
+        queueDesiredOrOff(generation, Request.KIND_MANUAL);
+    }
+
+    private void updateDesired(int brightness, int warmth) {
+        if (brightness > 0) {
+            mEnabled = true;
+            mDesiredBrightness = brightness;
+            mDesiredWarmth = warmth;
+            mLastBrightness = brightness;
+            mLastWarmth = warmth;
+        } else {
+            mEnabled = false;
+        }
+        persistState();
+        publishState();
+    }
+
+    private void queueDesiredOrOff(long generation, int kind) {
+        if (!mStateLoaded || !mSetupComplete) return;
+        mPending = selectPhysicalRequest(generation, kind, mDisplayOn,
+                mCompletedOffEpoch == mScreenEpoch, mWakeRestorePending, mEnabled,
+                mDesiredBrightness, mDesiredWarmth, mScreenEpoch);
+        if (mPending == null) return;
+        scheduleDrain();
+    }
+
+    static Request selectPhysicalRequest(long generation, int kind, boolean displayOn,
+            boolean offCompleted, boolean wakeRestorePending, boolean enabled,
+            int brightness, int warmth, long epoch) {
+        if (!displayOn && offCompleted) return null;
+        if (!displayOn || wakeRestorePending || !enabled) {
+            return Request.off(generation, epoch);
+        }
+        return Request.user(kind, generation, brightness, warmth);
+    }
+
+    /** Native brightness preserves the manager-owned warmth read on the serialized handler. */
+    static Request nativeBrightnessRequest(long generation, int brightness, int acceptedWarmth) {
+        return Request.brightness(generation, brightness, acceptedWarmth);
+    }
+
+    private void loadState() {
+        boolean present = getSecureInt(STATE_PRESENT, 0) != 0;
+        if (present) {
+            mEnabled = getSecureInt(STATE_ENABLED, 1) != 0;
+            mDesiredBrightness = sanitizeNonzero(
+                    getSecureInt(STATE_BRIGHTNESS, INITIAL_BRIGHTNESS), INITIAL_BRIGHTNESS);
+            mDesiredWarmth = sanitizePercent(
+                    getSecureInt(STATE_WARMTH, INITIAL_WARMTH), INITIAL_WARMTH);
+            mLastBrightness = sanitizeNonzero(
+                    getSecureInt(STATE_LAST_BRIGHTNESS, mDesiredBrightness), mDesiredBrightness);
+            mLastWarmth = sanitizePercent(
+                    getSecureInt(STATE_LAST_WARMTH, mDesiredWarmth), mDesiredWarmth);
+        }
+        mInitialization.loadConsumed(Settings.Secure.getIntForUser(
+                getContext().getContentResolver(), INITIALIZATION_MARKER, 0,
+                UserHandle.USER_SYSTEM) != 0);
+        mDisplayOn = readDisplayOn();
+        mStateLoaded = true;
+        publishState();
+        persistState();
+        handleSetupStateChanged();
+    }
+
+    private void handleSetupStateChanged() {
+        if (!mStateLoaded || mSetupComplete || getSecureInt(
+                Settings.Secure.USER_SETUP_COMPLETE, 0) == 0) return;
+        mSetupComplete = true;
+        long generation = mLatestGeneration.incrementAndGet();
+        mInitialization.begin(generation);
+        queueDesiredOrOff(generation, Request.KIND_INITIALIZATION);
+    }
+
+    private void handleDisplayState(boolean displayOn) {
+        if (!mStateLoaded || displayOn == mDisplayOn) return;
+        if (displayOn) {
+            handleDisplayOn();
+        } else {
+            handleDisplayOff();
+        }
+    }
+
+    private void handleDisplayOff() {
+        mDisplayOn = false;
+        mWakeRestorePending = false;
+        mCompletedOffEpoch = -1;
+        mScreenEpoch++;
+        mPending = Request.off(mLatestGeneration.incrementAndGet(), mScreenEpoch);
+        scheduleDrain();
+    }
+
+    private void handleDisplayOn() {
+        mDisplayOn = true;
+        if (!mSetupComplete) return;
+        if (mCompletedOffEpoch == mScreenEpoch) {
+            queueDesired();
+        } else {
+            mWakeRestorePending = true;
+        }
+    }
+
+    private void queueDesired() {
+        mWakeRestorePending = false;
+        long generation = mLatestGeneration.incrementAndGet();
+        mPending = mEnabled
+                ? Request.restore(generation, mDesiredBrightness, mDesiredWarmth)
+                : Request.off(generation, mScreenEpoch);
+        scheduleDrain();
+    }
+
+    private void scheduleDrain() {
+        if (mDrainScheduled) return;
+        mDrainScheduled = true;
+        mHandler.post(this::drainOne);
+    }
+
+    private void drainOne() {
+        Request request = mPending;
+        mPending = null;
+        if (request == null) {
+            mDrainScheduled = false;
+            return;
+        }
+        if (request.generation != mLatestGeneration.get()) {
+            continueDrain();
+            return;
+        }
+        int result = invokeCalibratedService(request.brightness, request.warmth);
+        if (request.generation == mLatestGeneration.get()) {
+            consumeCurrentResult(request, result);
+        }
+        continueDrain();
+    }
+
+    private void continueDrain() {
+        if (mPending != null) mHandler.post(this::drainOne);
+        else mDrainScheduled = false;
+    }
+
+    private void consumeCurrentResult(Request request, int result) {
+        boolean successful = result == RESULT_APPLIED || result == RESULT_CAPPED
+                || result == RESULT_OFF;
+        boolean consumed = request.kind == Request.KIND_INITIALIZATION
+                ? mInitialization.finishInitialization(
+                        request.generation, mLatestGeneration.get(), successful)
+                : (request.kind == Request.KIND_MANUAL || request.kind == Request.KIND_BRIGHTNESS)
+                        && mInitialization.finishUserRequest(
+                                request.generation, mLatestGeneration.get(), successful);
+        if (consumed && !Settings.Secure.putIntForUser(getContext().getContentResolver(),
+                INITIALIZATION_MARKER, 1, UserHandle.USER_SYSTEM)) {
+            Slog.w(TAG, "Unable to persist front-light initialization marker");
+        }
+        if (request.kind == Request.KIND_OFF) {
+            if (result == RESULT_OFF) {
+                mCompletedOffEpoch = request.epoch;
+                if (mWakeRestorePending && mDisplayOn) queueDesired();
+            } else {
+                mWakeRestorePending = false;
+            }
+            return;
+        }
+        if (successful && request.kind == Request.KIND_INITIALIZATION) persistState();
+    }
+
+    private int invokeCalibratedService(int brightness, int warmth) {
+        IBinder service = ServiceManager.getService(CONTROL_SERVICE);
+        if (service == null) return RESULT_UNAVAILABLE;
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(CONTROL_DESCRIPTOR);
+            data.writeInt(brightness);
+            data.writeInt(warmth);
+            if (!service.transact(CONTROL_TRANSACTION, data, reply, 0)) return RESULT_FAILED;
+            reply.readException();
+            return reply.readInt();
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Calibrated front-light request failed", e);
+            return RESULT_FAILED;
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+
+    private boolean readDisplayOn() {
+        Display display = mDisplayManager.getDisplay(Display.DEFAULT_DISPLAY);
+        return display != null && display.getState() == Display.STATE_ON;
+    }
+
+    private int getSecureInt(String key, int defaultValue) {
+        return Settings.Secure.getIntForUser(getContext().getContentResolver(), key,
+                defaultValue, UserHandle.USER_SYSTEM);
+    }
+
+    private void persistState() {
+        boolean success = putSecureInt(STATE_ENABLED, mEnabled ? 1 : 0)
+                & putSecureInt(STATE_BRIGHTNESS, mDesiredBrightness)
+                & putSecureInt(STATE_WARMTH, mDesiredWarmth)
+                & putSecureInt(STATE_LAST_BRIGHTNESS, mLastBrightness)
+                & putSecureInt(STATE_LAST_WARMTH, mLastWarmth)
+                & putSecureInt(STATE_PRESENT, 1);
+        if (!success) Slog.w(TAG, "Unable to persist desired front-light state");
+    }
+
+    private boolean putSecureInt(String key, int value) {
+        return Settings.Secure.putIntForUser(getContext().getContentResolver(), key, value,
+                UserHandle.USER_SYSTEM);
+    }
+
+    private void publishState() {
+        mPublishedState = new PublishedState(mEnabled,
+                mEnabled ? mDesiredBrightness : mLastBrightness,
+                mEnabled ? mDesiredWarmth : mLastWarmth);
+    }
+
+    private static int sanitizePercent(int value, int fallback) {
+        return isPercent(value) ? value : fallback;
+    }
+
+    private static int sanitizeNonzero(int value, int fallback) {
+        return value >= 1 && value <= 100 ? value : fallback;
+    }
+
+    private static boolean isPercent(int value) {
+        return value >= 0 && value <= 100;
+    }
+
+    static final class PublishedState {
+        final boolean enabled;
+        final int brightness;
+        final int warmth;
+
+        PublishedState(boolean enabled, int brightness, int warmth) {
+            this.enabled = enabled;
+            this.brightness = brightness;
+            this.warmth = warmth;
+        }
+
+        int[] toArray() {
+            return new int[] {enabled ? 1 : 0, brightness, warmth};
+        }
+    }
+
+    static final class Request {
+        static final int KIND_MANUAL = 0;
+        static final int KIND_BRIGHTNESS = 1;
+        static final int KIND_OFF = 2;
+        static final int KIND_RESTORE = 3;
+        static final int KIND_INITIALIZATION = 4;
+        final int kind;
+        final long generation;
+        final long epoch;
+        final int brightness;
+        final int warmth;
+
+        private Request(int kind, long generation, long epoch, int brightness, int warmth) {
+            this.kind = kind;
+            this.generation = generation;
+            this.epoch = epoch;
+            this.brightness = brightness;
+            this.warmth = warmth;
+        }
+
+        static Request manual(long generation, int brightness, int warmth) {
+            return new Request(KIND_MANUAL, generation, -1, brightness, warmth);
+        }
+
+        static Request brightness(long generation, int brightness, int warmth) {
+            return new Request(KIND_BRIGHTNESS, generation, -1, brightness, warmth);
+        }
+
+        static Request user(int kind, long generation, int brightness, int warmth) {
+            return new Request(kind, generation, -1, brightness, warmth);
+        }
+
+        static Request off(long generation, long epoch) {
+            return new Request(KIND_OFF, generation, epoch, 0, 0);
+        }
+
+        static Request restore(long generation, int brightness, int warmth) {
+            return new Request(KIND_RESTORE, generation, -1, brightness, warmth);
+        }
+
+        static Request initialization(long generation, int brightness, int warmth) {
+            return new Request(KIND_INITIALIZATION, generation, -1, brightness, warmth);
+        }
+    }
+
+    static final class InitializationTracker {
+        private boolean mLoaded;
+        private boolean mAttempted;
+        private boolean mConsumed;
+        private long mInitializationGeneration = -1;
+
+        void loadConsumed(boolean consumed) {
+            mLoaded = true;
+            mConsumed = consumed;
+        }
+
+        boolean begin(long generation) {
+            if (!mLoaded || mAttempted || mConsumed) return false;
+            mAttempted = true;
+            mInitializationGeneration = generation;
+            return true;
+        }
+
+        boolean finishInitialization(long generation, long currentGeneration, boolean success) {
+            if (mConsumed || !success || generation != currentGeneration
+                    || generation != mInitializationGeneration) {
+                return false;
+            }
+            mConsumed = true;
+            return true;
+        }
+
+        boolean finishUserRequest(long generation, long currentGeneration, boolean success) {
+            if (mConsumed || !success || generation != currentGeneration) return false;
+            mConsumed = true;
+            return true;
+        }
+    }
+}
