+/** Neo2-only desired-state controls; slider drag events never call the manager. */
+@Composable
+fun Neo2FrontLightSliderComposable() {
+    val manager = remember { Neo2FrontLightManager.connect() }
+    val initial = remember(manager) { manager?.state }
+    val scope = rememberCoroutineScope()
+    var available by remember { mutableStateOf(initial?.available == true) }
+    var enabled by remember { mutableStateOf(initial?.enabled ?: false) }
+    var brightness by remember {
+        mutableFloatStateOf(((initial?.brightness ?: 50) / 100f).coerceIn(0f, 1f))
+    }
+    var warmth by remember {
+        mutableFloatStateOf(((initial?.warmth ?: 50) / 100f).coerceIn(0f, 1f))
+    }
+    var dragging by remember { mutableStateOf(false) }
+
+    fun refreshFromManager() {
+        val state = manager?.state
+        available = state?.available == true
+        if (state != null && state.available && !dragging) {
+            enabled = state.enabled
+            brightness = (state.brightness / 100f).coerceIn(0f, 1f)
+            warmth = (state.warmth / 100f).coerceIn(0f, 1f)
+        }
+    }
+
+    LaunchedEffect(manager) {
+        while (currentCoroutineContext().isActive) {
+            refreshFromManager()
+            delay(FRONTLIGHT_STATE_REFRESH_MILLIS)
+        }
+    }
+
+    Surface(color = MaterialTheme.colorScheme.surface, tonalElevation = 6.dp) {
+        Neo2FrontLightControls(
+            available = available,
+            enabled = enabled,
+            brightness = brightness,
+            warmth = warmth,
+            onEnabledChange = { requested ->
+                manager?.setEnabled(requested)
+                scope.launch {
+                    delay(FRONTLIGHT_REQUEST_REFRESH_MILLIS)
+                    refreshFromManager()
+                }
+            },
+            onBrightnessChange = {
+                dragging = true
+                brightness = it
+            },
+            onWarmthChange = {
+                dragging = true
+                warmth = it
+            },
+            onValueChangeFinished = {
+                dragging = false
+                manager?.submitManualRequest(
+                    (brightness * 100).roundToInt(),
+                    (warmth * 100).roundToInt(),
+                )
+                scope.launch {
+                    delay(FRONTLIGHT_REQUEST_REFRESH_MILLIS)
+                    refreshFromManager()
+                }
+            },
+        )
+    }
+}
+
+/** Manager-backed replacement for the inert platform-brightness slider in expanded QS. */
+@Composable
+fun Neo2QuickSettingsBrightnessSliderComposable(modifier: Modifier = Modifier) {
+    val manager = remember { Neo2FrontLightManager.connect() }
+    val initial = remember(manager) { manager?.state }
+    val brightnessContentDescription =
+        stringResource(R.string.neo2_frontlight_brightness_content_description)
+    val scope = rememberCoroutineScope()
+    var available by remember { mutableStateOf(initial?.available == true) }
+    var dragging by remember { mutableStateOf(false) }
+    var brightness by remember {
+        mutableFloatStateOf(((initial?.brightness ?: 50) / 100f).coerceIn(0f, 1f))
+    }
+
+    fun refreshFromManager() {
+        val state = manager?.state
+        available = state?.available == true
+        if (state != null && state.available && !dragging) {
+            brightness = (state.brightness / 100f).coerceIn(0f, 1f)
+        }
+    }
+
+    LaunchedEffect(manager) {
+        while (currentCoroutineContext().isActive) {
+            refreshFromManager()
+            delay(FRONTLIGHT_STATE_REFRESH_MILLIS)
+        }
+    }
+
+    Surface(modifier = modifier, color = MaterialTheme.colorScheme.surface, tonalElevation = 3.dp) {
+        Column(modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)) {
+            Text(text = stringResource(R.string.neo2_frontlight_label))
+            Slider(
+                value = brightness,
+                onValueChange = {
+                    dragging = true
+                    brightness = it
+                },
+                onValueChangeFinished = {
+                    dragging = false
+                    manager?.submitBrightnessRequest((brightness * 100).roundToInt())
+                    scope.launch {
+                        delay(FRONTLIGHT_REQUEST_REFRESH_MILLIS)
+                        refreshFromManager()
+                    }
+                },
+                enabled = available,
+                modifier =
+                    Modifier.fillMaxWidth()
+                        .testTag(NEO2_QS_FRONTLIGHT_BRIGHTNESS_TEST_TAG)
+                        .semantics { contentDescription = brightnessContentDescription },
+            )
+        }
+    }
+}
+
+/** Stateless content; the caller owns transient drag state and final submissions. */
+@Composable
+internal fun Neo2FrontLightControls(
+    available: Boolean = true,
+    enabled: Boolean,
+    brightness: Float,
+    warmth: Float,
+    onEnabledChange: (Boolean) -> Unit,
+    onBrightnessChange: (Float) -> Unit,
+    onWarmthChange: (Float) -> Unit,
+    onValueChangeFinished: () -> Unit,
+) {
+    Column(modifier = Modifier.fillMaxWidth().padding(8.dp)) {
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Text(text = stringResource(R.string.neo2_frontlight_label))
+            Switch(
+                checked = enabled && available,
+                onCheckedChange = onEnabledChange,
+                enabled = available,
+                modifier = Modifier.testTag(NEO2_FRONTLIGHT_SWITCH_TEST_TAG),
+            )
+        }
+        Text(text = stringResource(R.string.neo2_frontlight_brightness_label))
+        Slider(
+            value = brightness,
+            onValueChange = onBrightnessChange,
+            onValueChangeFinished = onValueChangeFinished,
+            enabled = available && enabled,
+            modifier = Modifier.fillMaxWidth().testTag(NEO2_FRONTLIGHT_BRIGHTNESS_TEST_TAG),
+        )
+        Text(text = stringResource(R.string.neo2_frontlight_warmth_label))
+        Slider(
+            value = warmth,
+            onValueChange = onWarmthChange,
+            onValueChangeFinished = onValueChangeFinished,
+            enabled = available && enabled,
+            modifier = Modifier.fillMaxWidth().testTag(NEO2_FRONTLIGHT_WARMTH_TEST_TAG),
+        )
+    }
+}
+
+internal const val NEO2_FRONTLIGHT_SWITCH_TEST_TAG = "neo2_frontlight_switch"
+internal const val NEO2_FRONTLIGHT_BRIGHTNESS_TEST_TAG = "neo2_frontlight_brightness"
+internal const val NEO2_FRONTLIGHT_WARMTH_TEST_TAG = "neo2_frontlight_warmth"
+internal const val NEO2_QS_FRONTLIGHT_BRIGHTNESS_TEST_TAG = "neo2_qs_frontlight_brightness"
+private const val FRONTLIGHT_STATE_REFRESH_MILLIS = 1_000L
+private const val FRONTLIGHT_REQUEST_REFRESH_MILLIS = 50L
