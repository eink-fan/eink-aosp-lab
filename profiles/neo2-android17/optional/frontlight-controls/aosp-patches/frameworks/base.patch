+                    enabledValues += it
+                },
+                onBrightnessChange = {},
+                onWarmthChange = {},
+                onValueChangeFinished = {},
+            )
+        }
+
+        composeRule.onNodeWithTag(NEO2_FRONTLIGHT_SWITCH_TEST_TAG).performClick()
+
+        composeRule.runOnIdle { assertEquals(listOf(false), enabledValues) }
+    }
