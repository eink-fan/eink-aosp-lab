+    @Test
+    fun dragUpdatesOnlyTransientValueAndReleaseSubmitsOneAtomicPair() {
+        var enabled by mutableStateOf(true)
+        var brightness by mutableFloatStateOf(0.5f)
+        var warmth by mutableFloatStateOf(0.75f)
+        val submittedValues = mutableListOf<Pair<Int, Int>>()
+        composeRule.setContent {
+            Neo2FrontLightControls(
+                enabled = enabled,
+                brightness = brightness,
+                warmth = warmth,
+                onEnabledChange = { enabled = it },
+                onBrightnessChange = { brightness = it },
+                onWarmthChange = { warmth = it },
+                onValueChangeFinished = {
+                    submittedValues +=
+                        (brightness * 100).roundToInt() to (warmth * 100).roundToInt()
+                },
+            )
+        }
+
+        brightnessSlider().performTouchInput { swipeRight() }
+
+        composeRule.runOnIdle {
+            assertEquals(listOf(100 to 75), submittedValues)
+        }
+    }
