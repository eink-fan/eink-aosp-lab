diff --git a/private/neo2_frontlight.te b/private/neo2_frontlight.te
new file mode 100644
index 0000000000000000000000000000000000000000..9df529a7bcbd847e650fe7ad33693f45efe207d5
--- /dev/null
+++ b/private/neo2_frontlight.te
@@ -0,0 +1,14 @@
+# The externally discoverable front-light service is the
+# system-server mediator. SurfaceFlinger's calibrated endpoint remains a
+# private service and accepts calls only from system_server.
+type neo2_frontlight_manager_service, service_manager_type;
+
+add_service(system_server, neo2_frontlight_manager_service)
+allow system_server neo2_frontlight_control_service:service_manager find;
+
+# SystemUI owns Neo2's final-value slider; the platform-signed Controls app
+# owns the paired brightness/warmth controls. Neither may find the calibrated
+# SurfaceFlinger endpoint after the atomic migration.
+allow system_app neo2_frontlight_manager_service:service_manager find;
+allow platform_app neo2_frontlight_manager_service:service_manager find;
+# End of Neo 2 front-light manager policy.
