 genfscon sysfs /devices/platform/soc/soc:mtk_ireader/pix_fmt u:object_r:neo2_eink_pix_fmt_sysfs:s0
+genfscon sysfs /devices/platform/soc/soc:mtk_ireader/vcomvalue u:object_r:neo2_eink_vcom_sysfs:s0
diff --git a/system/sepolicy/private/surfaceflinger.te b/system/sepolicy/private/surfaceflinger.te
--- a/system/sepolicy/private/surfaceflinger.te
+++ b/system/sepolicy/private/surfaceflinger.te
@@ -53 +53,5 @@
 allow surfaceflinger neo2_eink_pix_fmt_sysfs:file { open write };
