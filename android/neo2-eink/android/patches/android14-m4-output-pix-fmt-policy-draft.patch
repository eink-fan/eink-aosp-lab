@@ -106 +106,15 @@
type neo2_eink_controller_device, dev_type;
# The retained Zhangyue driver reads only these two RM06L raw partitions while
# loading waveform and token/VCOM metadata. This is not generic block access.
type neo2_eink_waveform_storage_block_device, dev_type;
+# One RM06L output-control sysfs attribute. This type is intentionally
+# separate from both generic sysfs and the e-ink controller character nodes.
+type neo2_eink_pix_fmt_sysfs, fs_type, sysfs_type, mlstrustedobject;
+
+# One RM06L calibration attribute read by the retained engine during startup.
+# It is deliberately separate from generic sysfs and remains read-only.
+type neo2_eink_vcom_sysfs, fs_type, sysfs_type, mlstrustedobject;
+
+# One RM06L waveform-temperature attribute. The retained engine opens it
+# write-only as part of its own LUT setup; it is not a general thermal node.
+type neo2_eink_temper_info_sysfs, fs_type, sysfs_type, mlstrustedobject;
