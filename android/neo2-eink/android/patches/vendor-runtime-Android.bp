cc_library_shared {
    name: "libneo2_vendor_sync_link_probe",
    defaults: ["libcompositionengine_defaults"],
    srcs: ["vendor-runtime/vendor_sync_link_probe.cpp"],
    whole_static_libs: [
        "libneo2_eink_vendor_sync_backend",
        "libneo2_eink_presentation_core",
    ],
    shared_libs: ["libneo2_stock_einksfpatch"],
    compile_multilib: "64",
    installable: false,
    cpp_std: "c++20",
}
