// Generated into Neo2Eink/android/vendor-runtime/ by
// stage_m4_vendor_runtime_android14.sh. Do not put this file directly under a
// normal M1–M3 source graft. The gated product include is the only path that
// can install these private payload files; it remains off by default.

// These untouched stock binaries deliberately retain their vendor DT_NEEDED
// entries. The generic build cannot accurately declare that private closure as
// ordinary AOSP shared_libs, so only Soong's declaration-consistency check is
// disabled. Exact files and their loader inventory remain checksummed records.
cc_defaults {
    name: "neo2_stock_opaque_prebuilt_defaults",
    check_elf_files: false,
    strip: {
        none: true,
    },
}

// Exact stock waveform resources. Product gating selects these as data files;
// their presence does not load or initialize the retained engine.
prebuilt_etc {
    name: "neo2_stock_default_wbf",
    src: "vendor-runtime/waveforms/default_wbf.bin",
    filename: "default_wbf.bin",
}

prebuilt_etc {
    name: "neo2_stock_default_nm",
    src: "vendor-runtime/waveforms/default_nm.bin",
    filename: "default_nm.bin",
}

prebuilt_etc {
    name: "neo2_stock_regal_wbf",
    src: "vendor-runtime/waveforms/regal.wbf",
    filename: "regal.wbf",
}

// The calibrated front-light policy and its endpoint names are an exact,
// hash-locked restricted data payload. The Android controller remains
// disarmed by default even when this file is present.
prebuilt_etc {
    name: "neo2_stock_frontlight_calibration",
    src: "vendor-runtime/frontlight/neo2_frontlight_calibration.conf",
    filename: "neo2_frontlight_calibration.conf",
}

cc_prebuilt_library_shared {
    name: "libneo2_stock_einksfpatch",
    defaults: ["neo2_stock_opaque_prebuilt_defaults"],
    stem: "libeinksfpatch",
    srcs: ["vendor-runtime/libeinksfpatch.so"],
    compile_multilib: "64",
    installable: true,
}

cc_prebuilt_library_shared {
    name: "libneo2_stock_idisplayengine",
    defaults: ["neo2_stock_opaque_prebuilt_defaults"],
    stem: "libidisplayengine",
    srcs: ["vendor-runtime/libidisplayengine.so"],
