    name: "libneo2_stock_eink_ed070kc4",
    defaults: ["neo2_stock_opaque_prebuilt_defaults"],
    stem: "libeink_ED070KC4",
    srcs: ["vendor-runtime/payload-system/libeink_ED070KC4.so"],
